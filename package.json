{
  "name": "dsh-lab",
  "private": true,
  "type": "module",
  "description": "LabSideBar workspace surface for the DeepSeek Harness: sidebar icons, session tabs, drafts, and agent control.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bundle": "node scripts/build-client.mjs && node scripts/build-host.mjs && node scripts/build-tools.mjs",
    "bundle:host": "node scripts/build-host.mjs",
    "bundle:tools": "node scripts/build-tools.mjs",
    "test": "node --test packages/*/tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.host.json && tsc --noEmit -p tsconfig.tools.json"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.2.2-rc.1",
    "@types/node": "^20.17.57",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-api-remote-access": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-files": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-product-analytics": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-shortcuts": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-context-menu": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-jobs": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-schedule": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-util-values": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "^0.2.2-rc.1",
    "clsx": "^2.1.1"
  }
}
